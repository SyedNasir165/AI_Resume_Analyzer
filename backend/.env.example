# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5175

# Supabase — create a project at https://supabase.com
# SUPABASE_SERVICE_ROLE_KEY has full admin access — backend only, never expose to the frontend.
# No JWT secret needed: this project verifies auth tokens via Supabase's JWKS endpoint
# (asymmetric signing keys), derived from SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database — Supabase's Postgres connection string. Use the Session pooler URI (Connect ->
# Direct Connection -> Session pooler), not the direct db.<ref>.supabase.co host — that one
# is IPv6-only and won't resolve on most networks. If your DB password has special characters
# (@, :, /, %, etc.), percent-encode them in the URL (e.g. "@" -> "%40").
DATABASE_URL=

# Google Gemini — create a free-tier key at https://aistudio.google.com/apikey (later phase)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
